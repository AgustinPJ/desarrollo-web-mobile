# Variables que usa el backend.
VAULT_ADDR=http://127.0.0.1:8200
# Token root de Vault en modo dev: solo lo usa vault/cargar_secretos.py
VAULT_TOKEN=cambiar
MONGO_URI=mongodb://localhost:27017
# Clave del usuario operador de prueba (datos/cargar_datos.py y pruebas)
OPERADOR_PASSWORD=cambiar
# Opcionales del gateway
LIMITE_POR_MINUTO=300
LIMITE_LOGIN_POR_MINUTO=10
